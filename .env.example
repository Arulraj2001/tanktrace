# ============================================================
# TankTrace Environment Configuration
# ============================================================
#
# AWS Amazon Location Service Configuration
# When set, the interactive map will stream high-performance AWS vector / raster tiles.
# When omitted or empty, the application falls back gracefully to CartoDB / OpenStreetMap.
#
VITE_AWS_LOCATION_API_KEY=
VITE_AWS_LOCATION_MAP_NAME=explore.map
VITE_AWS_LOCATION_REGION=us-east-1

# Amazon S3 Processed Geospatial Data Endpoint (Optional)
# If configured, datasets will be streamed directly from your public/authenticated S3 bucket.
# If omitted or empty, the application serves bundled local data from /data.
# Example: https://tanktrace-geospatial-bucket.s3.us-east-1.amazonaws.com/data
#
VITE_S3_DATA_URL=

# Application Mode
VITE_APP_ENV=development
